      "metadata": {
        "id": "3669ff9e"
      },
      "source": [
        "Now we can train the `LogisticRegression` model on the scaled data. I will increase `max_iter` to ensure convergence."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "e53541fe",
        "outputId": "5a1c6947-ccfb-46e5-f92f-d796391cc0f2"
      },
      "source": [
        "model_logistic = LogisticRegression(max_iter=1000, random_state=42)\n",
        "model_logistic.fit(X_train_logistic_scaled, y_train_logistic)\n",
        "\n",
        "print(\"Logistic Regression model trained successfully!\")"
