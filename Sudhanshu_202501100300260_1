      "source": [
        "Now, let's redefine our features `X_logistic` and target `y_logistic` for the Logistic Regression model, excluding the original `Cost ($)` column."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "81b9cb53",
        "outputId": "6d2cb094-6167-4902-9b46-4ec5d26481db"
      },
      "source": [
        "X_logistic = df.drop(columns=['Cost ($)', 'High_Cost'])\n",
        "y_logistic = df['High_Cost']\n",
        "\n",
        "print(\"Features for Logistic Regression (X_logistic) shape:\", X_logistic.shape)\n",
        "print(\"Target for Logistic Regression (y_logistic) shape:\", y_logistic.shape)"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Features for Logistic Regression (X_logistic) shape: (1338, 8)\n",
            "Target for Logistic Regression (y_logistic) shape: (1338,)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "12119cdc"
      },
      "source": [
        "Next, we'll split the data into training and testing sets for the Logistic Regression model."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "27e47e72",
        "outputId": "8825b1e9-89a2-4865-999f-50221dacb6c1"
      },
      "source": [
        "X_train_logistic, X_test_logistic, y_train_logistic, y_test_logistic = train_test_split(\n",
        "    X_logistic, y_logistic, test_size=0.2, random_state=42, stratify=y_logistic\n",
        ")\n",
        "\n",
        "print(\"Logistic Regression Training set shape:\", X_train_logistic.shape)\n",
        "print(\"Logistic Regression Testing set shape:\", X_test_logistic.shape)"
